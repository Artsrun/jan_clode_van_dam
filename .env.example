# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: restrict who can talk to the bot (comma-separated Telegram user IDs)
# Leave empty to allow everyone (not recommended for production)
ALLOWED_USER_IDS=

# Claude model (defaults to claude-3-5-sonnet-20241022 if omitted)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# System prompt personality (optional)
SYSTEM_PROMPT=You are Jan Clode Van Dam — a slightly eccentric, precise, and helpful AI assistant living inside a Telegram bot. You think in elegant systems, notice hidden patterns, and never over-explain.
